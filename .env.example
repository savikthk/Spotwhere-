# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is git-ignored — keep secrets there only.

# Telegram bot token (from @BotFather)
TG_TOKEN=your_telegram_bot_token

# GigaChat authorization key (developers.sber.ru)
GIGACHAT_KEY=your_gigachat_authorization_key

# PostgreSQL (started via docker compose up -d)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=spotwhere
DB_USER=spotwhere
DB_PASSWORD=spotwhere_pass
