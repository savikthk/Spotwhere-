# Скопируй этот файл в .env и подставь свои значения:
#   cp .env.example .env
# .env в git НЕ попадает (он в .gitignore) — храни секреты только там.

# Токен Telegram-бота (от @BotFather)
TG_TOKEN=your_telegram_bot_token

# Ключ авторизации GigaChat (developers.sber.ru)
GIGACHAT_KEY=your_gigachat_authorization_key

# PostgreSQL (поднимается через docker compose up -d)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=spotwhere
DB_USER=spotwhere
DB_PASSWORD=spotwhere_pass
